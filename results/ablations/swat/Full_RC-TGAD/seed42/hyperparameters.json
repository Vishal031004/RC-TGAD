{
    "model": {
        "lstm_hidden": 128,
        "lstm_layers": 2,
        "gnn_out_dim": 128,
        "gnn_heads": 4,
        "dropout": 0.3,
        "window_size": 75,
        "d_in": 1,
        "num_nodes": 51
    },
    "rag": {
        "vector_dim": 128,
        "k_neighbors": 10,
        "alpha_1": 0.6,
        "alpha_2": 0.1,
        "alpha_3": 0.3,
        "gamma": 0.5
    },
    "curriculum": {
        "enabled": true,
        "k_warmup": 30,
        "safety_floor_ratio": 0.05,
        "fallback_ratio": 0.3
    },
    "training": {
        "epochs": 50,
        "batch_size": 128,
        "lr": 0.001,
        "weight_decay": 0.01,
        "grad_clip": 1.0,
        "device": "cuda",
        "seed": 42,
        "val_every": 5,
        "threshold": null
    },
    "data": {
        "dataset": "swat",
        "data_dir": "/kaggle/input/datasets/vishal0033/swat-raw/",
        "stride": 1,
        "train_split": 0.7,
        "val_split": 0.15,
        "test_split": 0.15,
        "normalize": true,
        "graph_threshold": 0.5
    },
    "logging": {
        "use_wandb": false,
        "wandb_project": "rc-tgad",
        "run_name": "Full_RC-TGAD_seed42",
        "checkpoint_dir": "checkpoints",
        "save_best_only": true,
        "log_every": 5
    }
}